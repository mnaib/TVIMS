			public function zeroPad(number:String, width:int):String
			{
				var ret:String="" + number;
				while (ret.length < width)
					ret="0" + ret;
				return ret;
			}
			
		
			
			private function nullLabelFunction(item:Object, column:GridColumn):String {
				if (item[column.dataField] == '<NULL>')
					return "";
				else
					return item[column.dataField];
			}
			
			private function nullLabelFunctionv(item:Object, column:GridColumn):String {
				if (item[column.dataField] == '<NULL>')
					return "";
				else
					if (item[column.dataField] == "1")
					return "var";
				else return "";
			}
			
			 
			
			private function tnullLabelFunction(item:Object, column:GridColumn):String {
				if (item[column.dataField] == '<NULL>')
					return "";
				else
					
					return tarPad(item[column.dataField].toString());
			} 
			public function tarPad(number:String):String
			{
				
		var ret:Array=number.split(" ");
				if (ret.length<2)  return number;
				var set:String=ret[0].toString();
				ret=set.split("/");
				
				if (ret.length<2) ret=set.split("-");
				if (ret.length<2) ret=set.split(".");
				if (ret.length<2) return number;
				return zeroPad(ret[1].toString(),2)+"."+zeroPad(ret[0].toString(),2)+"."+ret[2].toString();
			 
			 
			}
			private function ttnullLabelFunction(item:Object, column:GridColumn):String {
				if (item[column.dataField] == '<NULL>')
					return "";
				else
					
					return ttarPad(item[column.dataField] as Date);
			} 
			public function ttarPad(dd:Date):String
		
			{
		return		zeroPad(dd.date.toString(),2) +"."+zeroPad((dd.month+1).toString(),2)+"."+dd.fullYear+
			" " +zeroPad((dd.hours+1).toString(),2) + ":" + zeroPad((dd.minutes+1).toString(),2) + ":"+zeroPad((dd.seconds+1).toString(),2);			
			}
			
			
			
			
			
			
			
			
		
			
