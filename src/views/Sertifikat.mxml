			public function tarPad(number:String):String
			{
				var ret:Array=number.split("T")[0].toString().split("-");
				if (ret.length<2)  return number;
				 
				 
				return zeroPad(ret[2].toString(),2)+"."+zeroPad(ret[1].toString(),2)+"."+ret[0].toString();
			}
		 
		 
			
			 
			
