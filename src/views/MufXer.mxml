					content.oad = graphic.attributes.oad.toString();
					content.tel = graphic.attributes.tel.toString();
					content.ptel = graphic.attributes.ptel.toString();
					content.skype = graphic.attributes.skype.toString();
					content.vaxt = graphic.attributes.vaxt;
					
					 
					
					mer.text=ll.x.toFixed(5)
					par.text=ll.y.toFixed(5)
