			private function rregion(event:Event):void
			{
				var xml:XML=new XML(event.target.data);
				//		var xmllist: XMLListCollection= new XMLListCollection(xml.Cedvel);
				//		lreg.dataProvider=xmllist;
				//	var remma4:ArrayCollection=evt.result.Tables.Cedvel.Rows;
				
				var	ssoaota :XMLDocument = new XMLDocument(event.target.data);
				var sdsd:SOAPMessage=new SOAPMessage;
				sdsd.body=event.target.data;
				
				var aaa:SimpleXMLDecoder=new SimpleXMLDecoder();
				
				var fassd:Object=aaa.decodeXML(ssoaota);
				
				var fard:Array =fassd.Envelope.Body.CedvelResponse.CedvelResult.diffgram.DocumentElement.Cedvel as Array ;
				
				for each (var s:Object in fard)
				{
					
					
					
					var mmm:String="<NULL>";
					var ppp:String="<NULL>";
					
					
					
					ppp=StringUtil.trim(s.Paralel.toString());
					mmm =StringUtil.trim(s.Meridian.toString());
					
					if (!( (mmm=="<NULL>") || (ppp=="NULL") || (mmm=="0") || (ppp=="0") ) || (mmm==" ") || (ppp==" ") )
						
					{
						
						const mapint2:MapPoint = new MapPoint(parseFloat(mmm), parseFloat(ppp),   new SpatialReference(4326))
						const mat:MapPoint = WebMercatorUtil.geographicToWebMercator(mapint2) as MapPoint;
						
						//		const mapint2:MapPoint = new MapPoint(tmsPoint.x, tmsPoint.y,  new SpatialReference(4326))
						//			const mat:MapPoint = WebMercatorUtil.geographicToWebMercator(mapint2) as MapPoint;
						//			ObjectID	UserID	ObyektID	Qeyd	Mesaj	Paralel	Meridian	Seviyye	yt	syt	uad	oad
						//			1	65	0	0555557076		49.843377	40.379041	0.000000	2014-12-08 21:04:28.000	2014-12-08 21:05:46.000	Naib	
						
						
						var attributes:Object= { "userad": "","uad": "","oad": "","tel": "","ptel": "","vaxt": "","skype": ""} ;
						
						//		var observation:Observation = event.observation;
						
						
						
						
						if (s.Uad)			attributes.uad = s.Uad.toString();
						if (s.Oad)				attributes.oad = s.Oad.toString();
						if (s.Tel)				attributes.tel = s.Tel.toString();
						if (s.Ptel)				attributes.ptel =  s.Ptel.toString();
						
						if (s.Ytt)				attributes.vaxt =  s.Ytt.toString().replace("/",".").replace("/",".");
						
						
						
						var	graphic:Graphic = new Graphic(mat,null,
							attributes);
						
						
						graphic.addEventListener(MouseEvent.CLICK, clickHandler);
						//	if (!(oldid==observation.getTrackID().toString()))
						//			symbol.color=0x0990FF ;
						
						
						
						messageGraphics.addItem(graphic);				
						
						
						
						
					}
					
				}
				
				
			}
			 
