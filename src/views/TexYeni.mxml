			public function zeroPad(number:String, width:int):String
			{
				var ret:String="" + number;
				while (ret.length < width)
					ret="0" + ret;
				return ret;
			}
			
			
			
			public function tarPad(number:String):String
			{
				var ret:Array=number.split(" ");
				if (ret.length<2)  return number;
				var set:String=ret[0].toString();
				ret=set.split("/");
				
				if (ret.length<2) ret=set.split("-");
				if (ret.length<2) ret=set.split(".");
				if (ret.length<2) return number;
				return zeroPad(ret[1].toString(),2)+"."+zeroPad(ret[0].toString(),2)+"."+ret[2].toString();
			}
			private function getdate(dd:Date):String
			{	
				return zeroPad(dd.date.toString(),2) +"."+zeroPad((dd.month+1).toString(),2)+"."+dd.fullYear;				
			}
			private function gettime(dd:Date):String
			{				
				return zeroPad(dd.hours.toString(),2) +":"+zeroPad(dd.minutes.toString(),2)+":"+zeroPad(dd.seconds.toString(),2);				
			}
			
			
			
			
			
			
			
