			protected function onZoom2(e:TransformGestureEvent):void
			{
				
				
				if ((e.scaleX < 1) || (e.scaleY < 1))
				{
					
					img.scaleX/=1.03;
					img.scaleY/=1.03;
				}
				else
				{
					img.scaleX*=1.03;
					img.scaleY*=1.03;
				}
				
			}
			
			
			protected function ono(event:MouseEvent):void
			{
				var locX:Number=event.localX;
				
				var locY:Number=event.localY;
				var relativeZoom:Number=1.2;
				
				if (img.width < ter.width * 6)
				{
					
					img.scaleX*=relativeZoom;
					img.scaleY*=relativeZoom;
					
				}
				vp.horizontalScrollPosition=locX * img.scaleX - ter.width / 2;
				vp.verticalScrollPosition=locY * img.scaleY - ter.height / 2;
				
				
				
			}
			
			protected function onZoom(event:TransformGestureEvent):void
			{
				
				var locX:Number=event.localX;
				var locY:Number=event.localY;
				if ((event.scaleX < 1) || (event.scaleY < 1))
				{
					
					if (img.width > ter.width)
					{
						img.scaleX/=1.02;
						img.scaleY/=1.02;
					}
				}
				else
				{
					if (img.width < ter.width * 6)
					{
						img.scaleX*=1.02;
						img.scaleY*=1.02;
					}
					
				}
				
				
				vp.horizontalScrollPosition=locX * img.scaleX - ter.width / 2;
				vp.verticalScrollPosition=locY * img.scaleY - ter.height / 2;
				
			}
			
			
