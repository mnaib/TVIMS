				qeydbut.enabled=true
			}
			protected 	function qeydsor (event:PopUpEvent) 
			{
				if (event.data == MobileAlert.YES)
				{
					nlib.GetUrl("EXEC [Mufettis].[dbo].[MobQeydEt] @userid=" +mufo.usid +
						",@obid=" +mufo.osid +
						",@qeyd=N'" + nnqeyd.text+"'"
						,function  (event) 
						{
							MobileAlert.showt(' Qeyd təsdiqləndi ' , 'Məlumat')
							mufo.oqeyd=nnqeyd.text;
						});
				}
				
			}
			protected function qeydbut_clearHandler(event:Event):void
			{
				
				var dd:String="ggg";
				// TODO Auto-generated method stub
				MobileAlert.show( ' Qeyd əlavə eiləcək?', 'Qeyd', 9, this, 
					qeydsor);
				
			}
			
		]]>
	</fx:Script>
	
