			private function fotoidresult(event:Event):void
			{
				
				var xml:XML=new XML(nlib.DataToXml(event.target));
				
				var aar:Object= xml.Cedvel as Object;
				
				fotoids=aar.fotid.toString();
				
				
				var fotoidsstr:String="f" + zeroPad(fotoids, 9) + ".jpg";
				var fileext:String="f" + zeroPad(fotoids, 9) + "_.jpg";
				
				//	var file:File = File(filenamefoto);
				
				var filemov:File=WorkDir.resolvePath('ttnda/Mufettis/cache/' + fotoidsstr);
				
				filenamefoto.moveTo(filemov, true);
				
				var stream:FileStream=new FileStream();
				
				stream.open(filemov, FileMode.READ);
				var ba:ByteArray=new ByteArray();
				stream.readBytes(ba);
				stream.close();
				
				//Transform byteArray     to bitmapdata, to do that i use the function loadBytes
				
				var loader:Loader=new Loader();
				loader.contentLoaderInfo.addEventListener(Event.COMPLETE, onComplete_loader_contentLoaderInfo);
				loader.loadBytes(ba);
				
				
				function onComplete_loader_contentLoaderInfo(evt:Event):void
				{
					var content:*=loader.content;
					var bigBMD:BitmapData=new BitmapData(content.width, content.height, true, 0x00000000);
					bigBMD.draw(content, null, null, null, null, true);
					var numberFormatter:spark.formatters.NumberFormatter=new spark.formatters.NumberFormatter;
					numberFormatter.fractionalDigits=4;
					var nisbet:Number=bigBMD.height / bigBMD.width;
					
					
					///////////////////////////////////////////////////////	
					nisbetstr=numberFormatter.format(nisbet);
					var scale:Number=(150 / bigBMD.width);
					var matrix:Matrix=new Matrix();
					matrix.scale(scale, scale);
					var smallBMD:BitmapData=new BitmapData(bigBMD.width * scale, bigBMD.height * scale, true, 0x000000);
					smallBMD.draw(bigBMD, matrix, null, null, null, true);
					var jpg:JPEGEncoder=new JPEGEncoder(50);
					var myJPG:ByteArray=jpg.encode(smallBMD);
					var filemm:File=WorkDir.resolvePath('ttnda/Mufettis/cache/' + fileext);
					
					stream.open(filemm, FileMode.WRITE);
					stream.writeBytes(myJPG);
					stream.close();
					
					var inFile:File;
					
					if (kocur)
					{
						inFile=WorkDir.resolvePath('ttnda/Mufettis/cache/' + fotoidsstr);
						
						
					}
						
					else
					{
						var appDir:File=File.applicationDirectory;
						inFile=appDir.resolvePath('assets/fotomob.jpg');
						aaddItem(eslad, merhele.selectedItem.ad,fotostt2, fotoidsstr);
						var outFile:File=WorkDir.resolvePath('ttnda/Mufettis/foto/' + fotoidsstr);
						var filemov:File=WorkDir.resolvePath('ttnda/Mufettis/cache/' + fotoidsstr );
						
						filemov.copyTo(outFile, true);
						
					}
					
 
					var 	fqov:String='Mufettis'+"/f/"+fotoidsstr.substr(3,4);	
					
					//		uplods.token=srv2.qup(dataf, fotoidsstr, "Mufettis");
					nlib.UpFtp(inFile,  fqov,fotoidsstr,uplodsresult);
					
					
					
				}
			}
			
			
			
			
