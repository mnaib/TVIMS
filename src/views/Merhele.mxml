			public static function parsesql(date:String):Date
			{
				var split:Array = date.split("T");
				var splitDate:Array = split[0].split("-");
				var splitTime:Array = split[1].split(":");
				
				return new Date(splitDate[0],
					splitDate[1]-1,
					splitDate[2],
					splitTime[0],
					splitTime[1] );
			}
			
			private function result5(event:Event):void
			{
				var xmdec:XMLDecoder=new XMLDecoder();
				
				var ss4:Object=xmdec.decode(new XML(event.target.data));
				var db:ByteArray=new ByteArray();
				
				var		result:ArrayCollection=ss4.soap_Body.qdownmResponse.qdownmResult.bytestr as ArrayCollection;
				if (!result){
				result= new ArrayCollection();
				result.addItem(ss4.soap_Body.qdownmResponse.qdownmResult.bytestr);
				}
				for (var i:int=0; i < result.length; i++)
					
				{
					
					var outFile:File=WorkDir.resolvePath('ttnda/Mufettis/cache/' + result[i].name.toString());
					
					db=Dekod.decode(result[i].bayt);
					var outStream:FileStream=new FileStream();
					outStream.open(outFile, FileMode.WRITE);
					
					outStream.writeBytes(db, 0, db.length);
					// close it 
					outStream.close();
					
				}
				
				//	ilist.dataProvider=null;
				//	ilist.dataProvider=remm ;
				//	merrem.source=remm.source;
				merrem.removeAll();
				for (var i:int=0;  i<remm.length; i++)
				{
					if (remm[i].fid.toString()!=='f000000000_.jpg')						
						merrem.addItem(remm[i]);
					
				}
				
			}
			
			
			
