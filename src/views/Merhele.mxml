					o.id=parseInt(mufo.ovezid);
					
					
					o.ad=mufo.ovez;
					 
					vezsec.selectedIndex=o.id-1;
					return;  
				}
				 
				
				if (aar.vez)	mufo.ovez=aar.ad.toString();
			 
				if (aar.vezid)		mufo.ovezid=aar.id.toString();
				
				 
				var o:Object = new Object();
				o.id=parseInt(mufo.ovezid);
				
				
				o.ad=mufo.ovez;
				
				vezsec.selectedIndex=o.id-1;
				////	ltar.text=tablexml.NewDataSet.Table.ytarix.toString();
				
				persistenceManager.setProperty("mufo",mufo);
				persistenceManager.save();
	 
			}
			
			
			
