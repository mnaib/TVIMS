		<s:FlipViewTransition id="flipTrans" direction="up" duration="1000" mode="cube"/>
		<s:SlideViewTransition id="slideTrans" direction="left" duration="1000" easer="{bounce}" mode="cover"/>
		<s:CrossFadeViewTransition id="fadeTrans" duration="1000"/>
		 
		
		
	</fx:Declarations>
	
	<s:actionContent>
		<s:Button id="bback" click="navigator.popView(slideTrans)" icon="@Embed('../assets/back40.png')"/>
		
	</s:actionContent>
	
