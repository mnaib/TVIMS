<?xml version='1.0' encoding='utf-8'?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009" xmlns:s="library://ns.adobe.com/flex/spark" xmlns:components="components.*" xmlns:flextras="http://www.flextras.com/mxml" xmlns:adaptive="com.responsive.*" width="100%" height="100%" destructionPolicy="never" preinitialize="view1_initializeHandler(event)" creationComplete="view1_creationCompleteHandler(event)" title="Müfəttişlər" styleName="tvimsScreen">
	
	<fx:Script>
		<![CDATA[
			import com.*;
			
			import components.*;
			
			import mx.collections.ArrayCollection;
			import mx.collections.Sort;
			import mx.collections.SortField;
			import mx.collections.XMLListCollection;
			import mx.events.FlexEvent;
			import mx.rpc.AsyncResponder;
			import mx.rpc.Fault;
			import mx.rpc.events.FaultEvent;
			import mx.rpc.events.ResultEvent;
			import mx.rpc.soap.LoadEvent;
			import mx.rpc.soap.SOAPResult;
			import mx.utils.StringUtil;
			
			import spark.events.IndexChangeEvent;
			import spark.events.TextOperationEvent;
			[Embed("../assets/phone2.png")]
			[Bindable]
			private  var phone:Class; 
			[Embed("../assets/sms2.png")]
			[Bindable]
			private  var mail:Class; 
			import spark.managers.PersistenceManager;
			[Bindable]
			private var mufo:Mufo;
			
			 
			private var persistenceManager:PersistenceManager = new PersistenceManager;
			protected function view1_initializeHandler(event:FlexEvent):void
			{
				
				mufo= persistenceManager.getProperty("mufo") as Mufo;
			 
			
			}
			[Bindable] private var skp:String='';
			[Embed("../assets/video.png")]
			[Bindable]
			private  var vid:Class; 
			 
			[Bindable]
			private var  rsss:String="";
			
		  
			 
			protected function view1_creationCompleteHandler(event:FlexEvent):void
			{
				// TODO Auto-generated method stub
		//		region.token=srv.execSQL(sqs4, 'DML', "exec MobRegion ", 1000); 
				nlib.GetUrl("exec MobRegion " ,rregion);
				var mainApp:TTNDATVIMS = parentDocument as TTNDATVIMS;
			 
			 
			}
			private function rregion(event:Event):void
			{
 				var xml:XML=new XML(nlib.DataToXml(event.target));
				var xmllist: XMLListCollection= new XMLListCollection(xml.Cedvel);
 				lreg.dataProvider=xmllist;
				xmllist.refresh();
				lreg.selectedIndex=-1;			 
 			//	rayon.token=srv.execSQL(sqs4,'DML','exec MobRayon' ,1000);
				nlib.GetUrl('exec MobRayon' ,rrayon);
				
			}
			
			private function rrayon(event:Event):void
			{
				var xml:XML=new XML(nlib.DataToXml(event.target));
				var xmllist: XMLListCollection= new XMLListCollection(xml.Cedvel);			
				 			
				lray.dataProvider=xmllist;
				xmllist.refresh();
				lreg.selectedIndex=0;
				lray.selectedIndex=-1;
			//	user.token=srv.execSQL(sqs4,'DML','exec MobUser' ,1000);
				nlib.GetUrl('exec MobUser'  ,ruser);
			}
			private function ruser(event:Event):void
			{
				var xml:XML=new XML(nlib.DataToXml(event.target));
				var xmllist: XMLListCollection= new XMLListCollection(xml.Cedvel);		
				lmuf.dataProvider=xmllist;
				xmllist.refresh();
				lmuf.selectedIndex=-1;
			
			 lmuf.selectedIndex=0;
			 lray.selectedIndex=-1;
			   lray.selectedIndex=0;
			
			 lreg.selectedIndex=2;
			 lreg.dispatchEvent(new IndexChangeEvent(IndexChangeEvent.CHANGE));
			 
			}
			
			protected function zeng(ss:String):void
			{
				// TODO Auto-generated method stub
				if (ss.substr(0,1)!="0") ss="0"+ss;
				var u:URLRequest = new URLRequest("tel:" +ss);
				navigateToURL(u,"_self"); 
				
				
			}
			protected function vidik():void
			{
				
				var u:URLRequest = new URLRequest("skype:" + skp+ "?call&video=true " );
				navigateToURL(u,"_self"); 
				
				
			}
			protected function mesaj(ss:String ):void
			{
				// TODO Auto-generated method stub
				var u:URLRequest = new URLRequest("sms:" +ss);
				navigateToURL(u,"_self"); 
			}
			
			protected function lreg_caretChangeHandler(event:IndexChangeEvent):void
			{
				if (lray.dataProvider ) {
				var factoryMethodsXLC:XMLListCollection=XMLListCollection(lray.dataProvider);			 
				factoryMethodsXLC.filterFunction = filterray;
				factoryMethodsXLC.refresh();
				lray.selectedIndex=0;
				lray.dispatchEvent(new IndexChangeEvent(IndexChangeEvent.CHANGE));
			
				}
			}
			
			private function filterfav(item:Object):Boolean{
				if(item.fav)
					return true;
				return false;
			}

		 
			 

			  
			private function filterFunc(item:Object):Boolean {			
				return item.ad.toString().toLowerCase().indexOf(regt.text.toLowerCase())!=-1;
			}
			protected function regt_changeHandler(event:TextOperationEvent):void
			{			
				var factoryMethodsXLC:XMLListCollection=XMLListCollection(lreg.dataProvider);
				if (regt.text.length<1)  {
					factoryMethodsXLC.filterFunction = null;
					factoryMethodsXLC.refresh();
				} else {
					factoryMethodsXLC.filterFunction = filterFunc;
					factoryMethodsXLC.refresh();					
				}
			}
			
		 
			private function filterray(item:Object):Boolean {
				var bb:Boolean=false;
			if (rayt.text.length<1) bb=true;
				else bb=item.ad.toString().toLowerCase().indexOf(rayt.text.toLowerCase())!=-1;
				if 	 (lreg.selectedIndex<0) return bb;
				
			/*	var bbs:Boolean=false;
				var oo:Object=new Object;
				oo=lreg.selectedItem.id.toString(); 
					oo= item.region.toString();
				bbs=item.region==lreg.selectedItem.table.id;
				 	*/
				return bb&&(item.region.toString()==lreg.selectedItem.id.toString());
			}
			protected function rayt_changeHandler(event:TextOperationEvent):void
			{			
				var factoryMethodsXLC:XMLListCollection=XMLListCollection(lray.dataProvider);			 
					factoryMethodsXLC.filterFunction = filterray;
					factoryMethodsXLC.refresh();					
			 
			}
			
			protected function lray_caretChangeHandler(event:IndexChangeEvent):void
			{
				// TODO Auto-generated method stub
				if (lmuf.dataProvider!=null ) {
					var factoryMethodsXLC:XMLListCollection=XMLListCollection(lmuf.dataProvider);			 
					factoryMethodsXLC.filterFunction = filteruser;
					factoryMethodsXLC.refresh();
					lmuf.selectedIndex=0;
					lmuf.dispatchEvent(new IndexChangeEvent(IndexChangeEvent.CHANGE));
				}
			}
			
			private function filteruser(item:Object):Boolean {
				var bb:Boolean=false;
				if (muft.text.length<1) bb=true;
				else bb=item.ad.toString().toLowerCase().indexOf(muft.text.toLowerCase())!=-1;
				if 	 (lray.selectedIndex<0) return bb;
				
				 	var bbs:Boolean=false;
				var rid:String= lray.selectedItem.id.toString(); 
			var sar:Array=item.rayonlar.toString().split(",");
			for (var i:int=0; i<sar.length; i++) 
			{
			if 	(rid==sar[i] )
			{bbs=true;
			break;}
			}	 
				return bb&&bbs;
			}
			protected function muft_changeHandler(event:TextOperationEvent):void
			{			
				var factoryMethodsXLC:XMLListCollection=XMLListCollection(lmuf.dataProvider);			 
				factoryMethodsXLC.filterFunction = filteruser;
				factoryMethodsXLC.refresh();					
				
			}
			
			protected function lmuf_changeHandler(event:IndexChangeEvent):void
			{
	 if ((lmuf.selectedIndex<0) || ( lmuf.selectedItem=== undefined) ){
		 	xmobt.visible=false;
				xmobm.visible=false;
			 
				return;
					
	 } 
				nad.text= lmuf.selectedItem.ad.toString();	
				
		//		nrey.text=  lmuf.selectedItem.loqin.toString();
				
			//	nunv.text=  lmuf.selectedItem.pl_tel.toString();
				nray.text=  lmuf.selectedItem.tel.toString();
				mufo.ovez=  lmuf.selectedItem.id.toString();
				skp=lmuf.selectedItem.skype.toString();
				
			 
		 
				
				if (nray.text.length>4){
				xmobt.visible=true;
					xmobm.visible=true;
				}
				else {
					xmobt.visible=false;
				xmobm.visible=false;
				}
				
			
			}
			
		]]>
	</fx:Script>
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
		
		
		
		
