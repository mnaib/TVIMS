<?xml version="1.0" encoding="utf-8"?>
<s:View xmlns:fx="http://ns.adobe.com/mxml/2009"
		xmlns:s="library://ns.adobe.com/flex/spark" xmlns:adaptive="com.responsive.*"
		viewActivate="view1_viewActivateHandler(event)"
		destructionPolicy="never"
		width="100%" height="100%"
		preinitialize="view1_initializeHandler(event)"
         styleName="tvimsScreen">
	<fx:Declarations>
		<!-- Place non-visual elements (e.g., services, value objects) here -->
		<s:Bounce id="bounce"/>
		<s:FlipViewTransition id="flipTrans"
							  mode="cube"
							  duration="200"
							  direction="up"/>
		<s:SlideViewTransition id="slideTrans"
							   mode="cover"
							   duration="200"
							   direction="left"
							   easer="{bounce}"/>
		<s:CrossFadeViewTransition id="fadeTrans"
								   duration="200"/>
		<s:ZoomViewTransition id="zoomTrans"
							  mode="out"
							  duration="200"/>
	
		<s:Fade target="{nad}"  id="xFade1"  alphaFrom="0.1" alphaTo="1" duration="1000"  repeatCount="2"   />
		
		
		
		<s:Move3D  target="{nad}"  id="xFade2" autoCenterTransform="true"
				 zBy="250"   
				  repeatCount="2" repeatBehavior="reverse" />
		
		<s:Rotate3D  target="{nad}"  id="xFade3"
			
						 angleYFrom="0" angleYTo="360" 
						duration="1000"
						autoCenterTransform="true"
					 repeatBehavior="reverse" 	 />
		
		<s:Rotate3D  target="{nad}"  id="xFade4"
					 
					 angleZFrom="0" angleZTo="360" 
					 duration="1000"
					 autoCenterTransform="true" />
		


	</fx:Declarations>

	<fx:Script><![CDATA[
		import com.*;
		import com.mesaj.components.MessageBox;
		
		import components.*;
		
		import flash.sensors.Geolocation;
		
		import mx.core.FlexGlobals;
		import mx.events.CloseEvent;
		import mx.events.FlexEvent;
		
		import spark.events.PopUpEvent;
		import spark.events.ViewNavigatorEvent;
		import spark.managers.PersistenceManager;
		[Bindable]
		private var mufo:Mufo;
		private var basilib:Boolean=false;
		private var persistenceManager:PersistenceManager=new PersistenceManager;
		private var timer:Timer=new  Timer(10000);
		public var gpsok:Boolean=false;
        // Screen sizing is handled by ResponsiveStage.


		protected function view1_initializeHandler(event:FlexEvent):void
		{
			
			mufo=persistenceManager.getProperty("mufo") as Mufo;
			titul.text="İstifadəçi: " + mufo.uad;
			//	ad.text=mufo.uad.toString();
			timer.addEventListener(TimerEvent.TIMER, gonderr);
		}
		protected var g:Geolocation = new Geolocation();    
		public function testgps():void
		{
			if(Geolocation.isSupported)
			{ 					
			 
			while (!gpsok) {		
					if(g.muted){ 
						
						//	var app:view ViewNavigatorApplication = FlexGlobals.topLevelApplication as TabbedViewNavigatorApplication
						gpsok=false;
						//			MessageBox.show(("Davam etmək üçün\n GPS-i işə salın\n" , 'Məlumat');		
						 MessageBox.show(this.parent, MessageBox.MB_OK, MessageBox.IC_ALERT, "Məlumat", "Diqqət! Davam etmək üçün\n GPS-i işə salın\n");
						//	return gpsok ;
					} 
					else
					{
						gpsok=true;
						 
					}
			}
			}
			else 
			{ 
				gpsok=true;
				 
				trace("GPS not supported"); 
				//testduz				MobileAlert.show("GPS YOXDUR\n " , 'Məlumat');	
			}
			gpsok=true;
			 
		}
		
		private function gonderr(evt:TimerEvent):void {
			
			testgps();	
			
		}
		public function method2(event:PopUpEvent):void
		{
			if (event.data == MobileAlert.YES)
			{
				//	fert.text = "You answer is 'yes' : "+ event.detail;
			mufo.Reset();	
			mufo.uad="Qonaq";
				mufo.usid="0";
				mufo.osid="0";
				mufo.ovezid="0";
				mufo.oad=" ";
				mufo.orey=" ";
				mufo.otey=" ";
				mufo.ounv=" ";
				mufo.oqeyd=" ";
				mufo.oray=" ";
				//	
				mufo.gor=false;
				persistenceManager.setProperty("mufo", mufo);
				navigator.popView();
				
				navigator.firstView=views.Login;
				
				navigator.pushView(Login);
			}
			else
			{
				//		fert.text = "You answer is 'No' : "+ event.detail;
				return;
			}
		}
		
		
		protected function button1_clickHandler():void
		{
			
			
			// TODO Auto-generated method stub
			
			
			
			MobileAlert.show('Hörmətli  ' + mufo.uad + '\n' + 'Siz Mufəttişlik sistemindən ÇIXMAQ İstəyirsiniz?', 'Sistemdən  ÇIXIŞ', 9, this, method2);
		
			//		NativeApplication.nativeApplication.exit();
		}
		
		
		protected function view1_viewActivateHandler(event:ViewNavigatorEvent):void
		{
			mufo=persistenceManager.getProperty("mufo") as Mufo;
	//		timer.start();	
	//		FlexGlobals.topLevelApplication.persistenceManager.getProperty("mufo");   
			//	MobileAlert.show('Hörmətli  '+ mufo.uad+ '\n'+'Siz Mufəttişlik sisteminə xoş gəlmisiniz !' , 'Sistemə  Giriş',9,this,method2);
			if (!(parseInt(mufo.osid) == 0))
			{
				nad.text=mufo.oad.toString();
				
				nrey.text=mufo.orey.toString();
				ntey.text=mufo.otey.toString();
				nunv.text=mufo.oray.toString() + ", " + mufo.ounv.toString();
				nqeyd.text=mufo.osif;
				nvez.text=mufo.ovez.toString();
			}
		
		
			   
	//		timer.start();	
		
		
		}
		
		protected function kestemiz(event:MouseEvent):void
		{
			// TODO Auto-generated method stub
			navigator.pushView(Mufler,zoomTrans);
	//		MobileAlert.show('İnternetə qənaət üçün  baxılmış obyektlərin  şəkilləri'+'\n'+'və sənədlər Yaddaşda saxlanılır və əlavə yer tutur.'+'\n'+' Vaxtaşırı bu faylları təmizləmək lazımdır.'+'\n'+'İndi Faylları təmizləmək İstəyirsinizmi?', 'Yaddaşın təmizlənməsi', 9, this, temizlekes);
			
			 
		}
		
		public function temizlekes(event:PopUpEvent):void
		{
			if (event.data == MobileAlert.YES)
			{
			var directory:File = File.applicationStorageDirectory.resolvePath('ttnda/cache/');
			
			if (directory.exists) {
				var contents:Array = directory.getDirectoryListing(); 
			trace('qovluq '+contents.length); 
			for (var i:uint = 0; i < contents.length; i++) 
			{
				trace(contents[i].name, contents[i].size); 
			}
				directory.deleteDirectory(true);
			}
			var directory2:File = File.applicationStorageDirectory.resolvePath('ttnda/cache/');
			 
			MobileAlert.showt('Yaddaş   təmizləndi.', 'Yaddaşın  təmizlənməsi');
		}
		}
		
		 
		protected function obol_click(event:MouseEvent):void
		{
			// obyektin koordinati yoxsa alert
			// gps coor >< 200 metr radius
			// yes basa 
			// else alert
			
		}
	
		protected function axtracc(event:MouseEvent):void
		{
			// TODO Auto-generated method stub
			if (basilib)
			{
				navigator.replaceView(Axtar,fadeTrans) ;
			}
			else
			{
				basilib=true;
				navigator.pushView(Axtar,fadeTrans) ;
			}
			 
		}
		
		protected function button2_clickHandler(event:MouseEvent):void
		{
			// TODO Auto-generated method stub
			
		}
		
		protected function gismon_clickHandler(event:MouseEvent):void
		{
			// TODO Auto-generated method stub
		if (mufo.ugis) navigator.pushView(Xerite,flipTrans)
		else  {
			MobileAlert.show('Sizin  GPS Monitoring bölməsinə icazəniz yoxdur ' , 'Məlumat');
		return;
		}
		}
		
	]]></fx:Script>

