			private function nullLabelFunction(item:Object, column:GridColumn):String {
				if (item[column.dataField] == '<NULL>')
					return "";
				else
					return item[column.dataField];
			}
			
			
			
			private function tnullLabelFunction(item:Object, column:GridColumn):String {
				if (item[column.dataField] == '<NULL>')
					return "";
				else
					
					return tarPad(item[column.dataField].toString());
			} 
			public function tarPad(number:String):String
			{
				var ret:Array=number.split(" ");
				if (ret.length<2)  return number;
				var set:String=ret[0].toString();
				ret=set.split("/");
				
				if (ret.length<2) ret=set.split("-");
				if (ret.length<2) ret=set.split(".");
				if (ret.length<2) return number;
				return zeroPad(ret[1].toString(),2)+"."+zeroPad(ret[0].toString(),2)+"."+ret[2].toString();
			}
		
			
			
