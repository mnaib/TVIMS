			import spark.managers.PersistenceManager;
			
			protected var WorkDir:File=File.applicationStorageDirectory;
			//	private	var webView:StageWebView = new StageWebView(); 
			private		var outFile:File=new File;
			private function nullLabelFunction(item:Object, column:GridColumn):String {
				if (item[column.dataField] == '<NULL>')
					return "";
				else
					return item[column.dataField];
			}
			
			
			
			protected function view1_viewActivateHandler(event:ViewNavigatorEvent):void
			{
				nlib.GetUrl(' EXEC Mufettis.dbo.MobGetQanun ',resul);
				
				
			}
			
			
			private function resul(event:Event):void {
				trace("Rayon GGG geldi" +(new Date()).toString()+"--"+(new Date()).milliseconds);
				var xml:XML=new XML(nlib.DataToXml(event.target));
				var xmlListCollection: XMLListCollection= new XMLListCollection(xml.Cedvel);
				senedt.dataProvider= xmlListCollection;
				senedt.columnHeaderGroup.height=0;
			 
				senedt.selectedIndex=0;
				reygost();
			}
			
			
			private function reygoster(event:MouseEvent):void
			{
				reygost();
			}		
			private function reygost():void
				{
				if  (senedt.selectedItem==null) return;
				
				var 	fname:String= senedt.selectedItem.fileAd.toString();	
				
				bash.text=senedt.selectedItem.ad.toString();
				qor.text=senedt.selectedItem.orqan.toString();
				tr.text=senedt.selectedItem.yt.toString();	
				outFile=WorkDir.resolvePath('ttnda/Mufettis/cache/' + fname);
				
				if (outFile.exists)
				{
					var hh:int=2;
					
					/*		
					var docac2:Doclanch=new Doclanch();
					docac2.openDoc(outFile.nativePath);
					*/			
					if (outFile.url.indexOf(".pdf")==-1)	
						wb.source=outFile.url;
						
					else {	
						var docac2:Doclanch=new Doclanch();
						docac2.openDoc(outFile.nativePath);
					}			
					
				}
				else
				{
					nlib.GetFtp('Mufettis', fname,outFile,downexr);
				}
				
				
				
				function downexr( ):void {
					
				if (outFile.url.indexOf(".pdf")==-1)	
					wb.source=outFile.url;
					
				else {	
					var docac2:Doclanch=new Doclanch();
					docac2.openDoc(outFile.nativePath);
				}			
				}
				
			}	
		]]>
	</fx:Script>
	
	
