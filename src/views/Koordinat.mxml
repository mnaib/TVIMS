            // V3: Map is a direct child of View. Its interactive surface is never transformed.
            private var mapLayoutPending:Boolean = false;
            private function requestMapLayout():void {
                if (mapLayoutPending) return;
                mapLayoutPending = true;
                callLater(applyMapLayout);
            }
            private function applyMapLayout():void {
                mapLayoutPending = false;
                var vw:Number = this.width;
                var vh:Number = this.height;
                if (isNaN(vw) || isNaN(vh) || vw < 200 || vh < 220) return;
                var pad:Number = 10;
                var headHeight:Number = (vh < 500) ? 46 : 60;
                var contentTop:Number = headHeight + pad * 2;
                nad.x = pad;
                nad.y = pad;
                nad.width = vw - pad * 2;
                nad.height = headHeight;
                var mapX:Number = pad;
                var mapY:Number = contentTop;
                var mapW:Number;
                var mapH:Number;
                var infoX:Number;
                var infoY:Number;
                var infoW:Number;
                var infoH:Number;
                if (vw >= vh && vw >= 710) {
                    // Wide screens: map on left, scrollable details on right.
                    infoW = vw >= 1120
                        ? Math.min(525, Math.max(460, vw * 0.39))
                        : Math.min(380, Math.max(265, vw * 0.35));
                    mapW = Math.max(230, vw - infoW - pad * 3);
                    mapH = Math.max(150, vh - mapY - pad);
                    infoX = mapX + mapW + pad;
                    infoY = mapY;
                    infoH = mapH;
                } else {
                    // Narrow screens: large map above a separately scrolling detail panel.
                    mapW = Math.max(150, vw - pad * 2);
                    var avail:Number = Math.max(170, vh - mapY - pad);
                    mapH = Math.max(135, Math.min(vh * 0.52, avail - 112));
                    mapH = Math.min(mapH, avail - 56);
                    infoX = pad;
                    infoY = mapY + mapH + pad;
                    infoW = mapW;
                    infoH = Math.max(46, vh - infoY - pad);
                }
                maps.x = mapX;
                maps.y = mapY;
                maps.width = mapW;
                maps.height = mapH;
                mapInfoScroll.x = infoX;
                mapInfoScroll.y = infoY;
                mapInfoScroll.width = infoW;
                mapInfoScroll.height = infoH;
                mapInfoCanvas.width = infoW;
                if (infoW >= 475) {
                    mapObjectPanel.x = Math.round(Math.max(0, (infoW - 454) / 3));
                    mapObjectPanel.y = 6;
                    mapGpsPanel.x = mapObjectPanel.x * 2 + 220;
                    mapGpsPanel.y = 6;
                    mapInfoCanvas.height = 716;
                } else {
                    mapGpsPanel.x = Math.max(0, Math.round((infoW - 226) / 2));
                    mapGpsPanel.y = 6;
                    mapObjectPanel.x = Math.max(0, Math.round((infoW - 220) / 2));
                    mapObjectPanel.y = 718;
                    mapInfoCanvas.height = 1430;
                }
                // Map controls remain View children so empty overlay containers never block gestures.
                myloc.x = mapX + 12;
                myloc.y = mapY + Math.min(158, Math.max(92, (mapH - 44) / 2));
                mapSatelliteControl.x = mapX + Math.max(2, mapW - 128);
                mapSatelliteControl.y = mapY + 12;
                mapStreetControl.x = mapSatelliteControl.x;
                mapStreetControl.y = mapY + 53;
                maps.invalidateSize();
                maps.invalidateDisplayList();
            }

]]></fx:Script>
	
