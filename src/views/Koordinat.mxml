			public function geoStatusHandler(event:StatusEvent):void 
			{ 
			if (geo.muted){
			geo.removeEventListener(GeolocationEvent.UPDATE, onUpdate);
			MobileAlert.show(' GPS-i işə salmaq lazımdır ' , 'Məlumat');
			}
			else{
				MobileAlert.showt(' GPS-i işə salındı ' , 'Məlumat');
			geo.addEventListener(GeolocationEvent.UPDATE, geoStatusHandler);
			}	
