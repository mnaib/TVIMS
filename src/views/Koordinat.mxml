				gpspoint.x=parmer.x;
				gpspoint.y=parmer.y;
				mappo=parmer;
				binapoint.x=gpspoint.x;
				binapoint.y=gpspoint.y;
				
				const mapPoint:MapPoint =new MapPoint(binapoint.x, binapoint.y, new SpatialReference(102100));
				const latlong:MapPoint = WebMercatorUtil.webMercatorToGeographic(mapPoint) as MapPoint;
				olong.text =latlong.x.toFixed(6);
				olat.text =latlong.y.toFixed(6);
				myGraphicPic.refresh();
				    /*   latitude.text= "Paralel:    " + event.latitude.toFixed(6) ; 
					longitude.text = "Meridian:   " + event.longitude.toFixed(6) ;
					altitude.text =  "Səviyyə:    " + event.altitude.toFixed(6) ; */
					  latitude.text=  event.latitude.toFixed(6) ; 
					longitude.text =   event.longitude.toFixed(6) ;
					altitude.text = event.altitude.toFixed(6) ;
					verticalAccuracy.text =  "H.dəq :     "+ event.verticalAccuracy.toFixed(2) ;
					horizontalAccuracy.text ="V.dəq:      " + event.horizontalAccuracy.toFixed(2);
					speed.text =     "Surət:      " + event.speed.toFixed(2) ;
					heading.text =   "İstiqamət:  "+ event.heading.toFixed(2) ;
					
					gpsp.refresh();
				// auto-scroll the text area to the latest text
		//		StyleableTextField(log.textDisplay).scrollV = StyleableTextField(log.textDisplay).scrollV+1;
			}
			
