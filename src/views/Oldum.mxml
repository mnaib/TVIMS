				var stt3:String="EXEC [Mufettis].[dbo].[MobOlubGet]  "+	mufo.usid +", "+mufo.osid;;
					
				
			//**	koorget.token=srv.execSQL(sqs2, 'DML', stt3, 1000);
				nlib.GetUrl(stt3   ,getresult);
				
				
				
			}
			
			public function geoStatusHandler(event:StatusEvent):void 
			{ 
			if (geo.muted){
			geo.removeEventListener(GeolocationEvent.UPDATE, onUpdate);
			MobileAlert.show(' GPS-i işə salmaq lazımdır ' , 'Məlumat');
			}
			else{
				MobileAlert.showt(' GPS-i işə salındı ' , 'Məlumat');
			geo.addEventListener(GeolocationEvent.UPDATE, geoStatusHandler);
			}	
			}
			protected function onUpdate(event:GeolocationEvent):void
			{
				trace("Update event called");
				const mapint:MapPoint = new MapPoint(event.longitude, event.latitude,  new SpatialReference(4326))
				const parmer:MapPoint = WebMercatorUtil.geographicToWebMercator(mapint) as MapPoint;
				gpspoint.x=parmer.x;
				gpspoint.y=parmer.y;
				mappo=parmer;
				      latitude.text= "Paralel:    " + event.latitude.toFixed(6) ; 
					longitude.text = "Meridian:   " + event.longitude.toFixed(6) ;
					altitude.text =  "Səviyyə:    " + event.altitude.toFixed(3) ;
			verticalAccuracy.text =  "H.dəq :     "+ event.verticalAccuracy.toFixed(2) ;
			horizontalAccuracy.text ="V.dəq:      " + event.horizontalAccuracy.toFixed(2);
					speed.text =     "Surət:      " + event.speed.toFixed(2) ;
					heading.text =   "İstiqamət:  "+ event.heading.toFixed(2) ;
				 
					gpsp.refresh();
			  xr =Math.sqrt((gpspoint.x-binapoint.x)*(gpspoint.x-binapoint.x));
		  yr =	 Math.sqrt(	(gpspoint.y-binapoint.y)*(gpspoint.y-binapoint.y));
			
			if ((xr<=200)&&(yr<=200))  oldum.enabled=true;
			else oldum.enabled=false;
			
			olongd =event.longitude.toFixed(6) ;
			olatd =event.latitude.toFixed(6) ; 
				// auto-scroll the text area to the latest text
		//		StyleableTextField(log.textDisplay).scrollV = StyleableTextField(log.textDisplay).scrollV+1;
			}
			
			
