			// Flex applicationDPI is chosen at application startup, not dynamically per View.
            // Width/height below are Flex display units after its own DPI scaling.
            // For the legacy root applicationDPI=160 this code uses 160-based
            // UI control dimensions; for the experimental no-applicationDPI mode,
            // the applicationDPI reflects device density and controls are sized
            // explicitly in Flex logical units. Do not scale the full root again.
            private var responsiveLayoutPending:Boolean = false;

            private function loginViewCreated():void
            {
                callLater(scheduleLoginLayout);
                updateok(); // Orijinal server/versiya yoxlaması dəyişmir.
            }

            private function scheduleLoginLayout():void
            {
                if (responsiveLayoutPending) return;
                responsiveLayoutPending = true;
                callLater(applyLoginLayout);
            }

            private function between(value:Number, low:Number, high:Number):Number
            {
                return Math.max(low, Math.min(high, value));
            }

            private function applyLoginLayout():void
            {
                responsiveLayoutPending = false;
                if (ert == null || screenLayout == null || loginCard == null) return;
                var vw:Number = ert.width;
                var vh:Number = ert.height;
                if (vw <= 0 || vh <= 0 || isNaN(vw) || isNaN(vh)) return;

                // Measure DPI BEFORE sizing controls. Flex may have already applied
                // runtimeDPI/applicationDPI scaling to the root application.
                var app:Object = FlexGlobals.topLevelApplication;
                var rDPI:Number = (app != null) ? Number(app.runtimeDPI) : 160;
                var aDPI:Number = (app != null) ? Number(app.applicationDPI) : 160;
                if (isNaN(aDPI) || aDPI < 72) aDPI = 160;
                var dpiFactor:Number = between(aDPI / 160, 0.75, 4.0);

                // Use actual Flex View dimensions, not the original 1280 x 720.
                var portrait:Boolean = vh > vw;
                var margin:Number = between(Math.min(vw, vh) * 0.025,
                                            12 * dpiFactor, 30 * dpiFactor);
                var gap:Number = between(vh * 0.02, 12 * dpiFactor, 24 * dpiFactor);
                var bannerWidth:Number = Math.max(1, vw); // full available screen width
                var bannerHeight:Number = bannerWidth * 267 / 1586; // original image ratio

                // Phone landscape / keyboard-open layouts reduce vertical spacing.
                var compact:Boolean = vh < 735 * dpiFactor;
                // Keep full-width banner proportional in either orientation.
                var cardWidth:Number = Math.min(vw - 2 * margin,
                                                (portrait ? 530 : 520) * dpiFactor);
                cardWidth = Math.max(1, cardWidth);
                var edge:Number = between(cardWidth * 0.062,
                                          16 * dpiFactor, 34 * dpiFactor);
                var fieldWidth:Number = Math.max(40, cardWidth - 2 * edge);
                var controlHeight:Number = (compact ? 43 : 50) * dpiFactor;
                var labelHeight:Number = (compact ? 22 : 25) * dpiFactor;
                var bodyFont:Number = between(cardWidth * 0.037,
                                              16 * dpiFactor, 19 * dpiFactor);
                var titleFont:Number = between(cardWidth * 0.065,
                                               25 * dpiFactor, 35 * dpiFactor);
                var y:Number = (compact ? 16 : 22) * dpiFactor;

                tvimsTitle.x = edge;
                tvimsTitle.y = y;
                tvimsTitle.width = fieldWidth;
                tvimsTitle.height = (compact ? 37 : 46) * dpiFactor;
                tvimsTitle.setStyle("fontSize", titleFont);
                y += tvimsTitle.height + ((compact ? 7 : 13) * dpiFactor);

                loginUserLabel.x = edge;
                loginUserLabel.y = y;
                loginUserLabel.width = fieldWidth;
                loginUserLabel.height = labelHeight;
                loginUserLabel.setStyle("fontSize", bodyFont);
                y += labelHeight + 5 * dpiFactor;

                adstr.x = edge;
                adstr.y = y;
                adstr.width = fieldWidth;
                adstr.height = controlHeight;
                adstr.setStyle("fontSize", bodyFont);
                y += controlHeight + ((compact ? 10 : 15) * dpiFactor);

                loginPasswordLabel.x = edge;
                loginPasswordLabel.y = y;
                loginPasswordLabel.width = fieldWidth;
                loginPasswordLabel.height = labelHeight;
                loginPasswordLabel.setStyle("fontSize", bodyFont);
                y += labelHeight + 5 * dpiFactor;

                pstr.x = edge;
                pstr.y = y;
                pstr.width = fieldWidth;
                pstr.height = controlHeight;
                pstr.setStyle("fontSize", bodyFont);
                y += controlHeight + 4 * dpiFactor;

                cBox.x = edge;
                cBox.y = y;
                cBox.width = fieldWidth;
                cBox.height = 33 * dpiFactor;
                cBox.setStyle("fontSize", between(bodyFont - dpiFactor, 14 * dpiFactor, 18 * dpiFactor));
                y += 33 * dpiFactor + ((compact ? 7 : 13) * dpiFactor);

                loqin.x = edge;
                loqin.y = y;
                loqin.width = fieldWidth;
                loqin.height = (compact ? 47 : 54) * dpiFactor;
                loqin.setStyle("fontSize", between(bodyFont + 3 * dpiFactor, 19 * dpiFactor, 23 * dpiFactor));
                y += loqin.height + 5 * dpiFactor;

                inff.x = edge;
                inff.y = y;
                inff.width = fieldWidth;
                inff.height = (compact ? 30 : 38) * dpiFactor;
                inff.setStyle("fontSize", between(bodyFont - 2 * dpiFactor, 14 * dpiFactor, 17 * dpiFactor));
                y += inff.height + dpiFactor;

                vers.x = edge;
                vers.y = y;
                vers.width = fieldWidth;
                vers.height = (compact ? 22 : 26) * dpiFactor;
                vers.setStyle("fontSize", between(bodyFont - 4 * dpiFactor, 12 * dpiFactor, 15 * dpiFactor));
                y += vers.height + ((compact ? 7 : 15) * dpiFactor);

                exitButton.x = edge;
                exitButton.y = y;
                exitButton.width = fieldWidth;
                exitButton.height = (compact ? 43 : 49) * dpiFactor;
                exitButton.setStyle("fontSize", between(bodyFont + dpiFactor, 17 * dpiFactor, 21 * dpiFactor));
                y += exitButton.height + ((compact ? 14 : 22) * dpiFactor);

                loginCard.width = cardWidth;
                loginCard.height = y;
                bannerGroup.width = bannerWidth;
                bannerGroup.height = bannerHeight;

                var totalHeight:Number = margin + bannerHeight + gap + loginCard.height + margin;
                screenLayout.width = vw;
                screenLayout.height = Math.max(vh, totalHeight);
                var startY:Number = Math.max(margin, (screenLayout.height - (bannerHeight + gap + loginCard.height)) / 2);
                bannerGroup.x = 0;
                bannerGroup.y = Math.round(startY);
                loginCard.x = Math.round((vw - cardWidth) / 2);
                loginCard.y = Math.round(startY + bannerHeight + gap);

                // Show device metrics in trace for testing (and optional UI label).
                var info:String = "View " + int(vw) + "x" + int(vh)
                    + " | raw DPI " + int(Capabilities.screenDPI)
                    + " | runtimeDPI " + int(rDPI)
                    + " | applicationDPI " + int(aDPI);
                trace("TTNDATVIMS responsive LOGIN: " + info);
                if (stage != null)
                    trace("Stage " + stage.stageWidth + "x" + stage.stageHeight
                          + " | fullScreen " + stage.fullScreenWidth + "x" + stage.fullScreenHeight);
                debugMetrics.text = info;
                debugMetrics.width = Math.max(50, vw - 2 * margin);
                debugMetrics.x = margin;
                debugMetrics.y = Math.max(0, screenLayout.height - 20);
            }

