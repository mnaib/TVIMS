    <!-- Full-screen background remains independent of the form/scroll area. -->
    <s:Group id="ert" width="100%" height="100%" resize="scheduleLoginLayout()">
        <s:Image left="0" right="0" top="0" bottom="0"
                 scaleMode="zoom" alpha="0.30"
                 source="assets/Building-Construction.jpg"
                 click="{stage.focus = null}" />

        <!-- Scroller allows the login to remain usable on short landscape screens
             and when the soft keyboard reduces the available viewport. -->
        <s:Scroller id="loginScroller" left="0" right="0" top="0" bottom="0"
                    horizontalScrollPolicy="off" verticalScrollPolicy="auto">
            <s:Group id="screenLayout">
                <!-- Original agency banner / logo: preserve source aspect ratio. -->
                <s:Group id="bannerGroup">
                    <s:Image left="0" right="0" top="0" bottom="0"
                             source="assets/fhnttnda.jpg" scaleMode="stretch" />
                </s:Group>

                <s:Group id="loginCard">
                    <s:Rect left="0" right="0" top="0" bottom="0" radiusX="18" radiusY="18">
                        <s:fill><s:SolidColor color="#FFFFFF" alpha="0.94" /></s:fill>
                        <s:stroke><s:SolidColorStroke color="#C4CCD4" weight="1" alpha="0.85" /></s:stroke>
                    </s:Rect>

                    <s:Label id="tvimsTitle" styleName="tvimsLoginTitle" text="TVIMS" fontWeight="bold" textAlign="center"
                             verticalAlign="middle" />

                    <s:Label id="loginUserLabel" text="İstifadəçi adı"
                             color="#273B56" fontWeight="bold" verticalAlign="middle" />
                    <s:TextInput id="adstr" styleName="tvimsLoginField" prompt="İstifadəçi adınızı yazın"
                                 enter="{stage.focus = null; pstr.setFocus();}" />

                    <s:Label id="loginPasswordLabel" text="Parol"
                             color="#273B56" fontWeight="bold" verticalAlign="middle" />
                    <s:TextInput id="pstr" styleName="tvimsLoginField azStyle" prompt="Parolu yazın"
                                 displayAsPassword="{!cBox.selected}"
                                 needsSoftKeyboard="true"
                                 enter="{stage.focus = null; button1_clickHandlere()}"
                                 />
                    <s:CheckBox id="cBox" label="Parolu göstər" selected="false" color="#344658" />

                    <s:Button id="loqin" styleName="tvimsPrimary" label="Sistemə GİRİŞ"
                              enabled="false" fontWeight="bold"
                              click="button1_clickHandler(event)" />
                    <s:Label id="inff" textAlign="center" verticalAlign="middle"
                             color="#B32635" />
                    <s:Label id="vers" styleName="tvimsMuted" textAlign="center" verticalAlign="middle"
                             color="#66727C" />
                    <s:Button id="exitButton" styleName="tvimsSecondary" label="Çıxış"
                              fontWeight="bold"
                              click="NativeApplication.nativeApplication.exit();" />
                </s:Group>
                <!-- Debug label is hidden by default; switch visible=true for first APK test. -->
                <s:Label id="debugMetrics" visible="false" color="#24364E" fontSize="11" />
            </s:Group>
        </s:Scroller>
    </s:Group>
</s:View>
