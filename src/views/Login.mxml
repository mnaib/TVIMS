			protected function loaduser():void
			{
				var file:File = File.applicationStorageDirectory.resolvePath("istad.ec");
				var stream:FileStream = new FileStream()
				if(!file.exists)
					return;
				stream.open(file, FileMode.READ);
				adstr.text ="";
				adstr.text = stream.readUTFBytes(stream.bytesAvailable);
				stream.close();
			 
			}
			
