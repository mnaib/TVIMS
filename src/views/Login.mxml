				nlib.GetUrl(sq1+"  '" +adstr.text.toString()+"',2,'"+pstr.text.toString()+"'",onResult);
	
			}
		 
	 private  function onResult(event:Event):void {
				trace("AXTAR GGG geldi" +(new Date()).toString()+"--"+(new Date()).milliseconds);
				
				var xml:XML=new XML(nlib.DataToXml(event.target));
				
				var aar:Object= xml.Cedvel as Object;
		
				
				mufo.usid= aar.id.toString(); 
				mufo.uad=aar.ad.toString();	
				mufo.userad=aar.loqin.toString();
				if ((parseInt(mufo.usid)>0))
					
				{
					inff.text="Siz sistemə DAXIL olmusunuz";
					
					mufo.gor=true;
					
					mufo.osid="0"; 
					
					mufo.oad=" ";	
					mufo.orey=" ";	
					mufo.otey=" ";	
					mufo.ounv=" ";	
					mufo.oqeyd=" ";	
					mufo.oray=" ";	
					
					mufo.uderece=aar.derece.toString();
					mufo.utel=aar.tel.toString();	
					if (mufo.utel.substr(0,1)!="0") mufo.utel="0"+mufo.utel;
					mufo.ptel=aar.ptel.toString();
					mufo.udo=aar.udo.toString();	
					mufo.skype=aar.skype.toString();	
					mufo.admin=parseInt(aar.admin.toString()) ;
						mufo.ugis=parseInt(aar.ugis.toString()) ;
						mufo.ukoor=parseInt(aar.ukoor.toString()) ;
					mufo.baxan=parseInt(aar.baxan.toString()) ;
				if ( aar.mm )	mufo.umm=aar.mm.toString() ;
					if ( aar.qrup  )	mufo.uqrup=aar.qrup.toString() ;
					mufo.duzelden=parseInt(aar.duzelden.toString()) ;
					
			/*		switch(mufo.uderece)
					{
						case '2': mufo.duzelden=true;
							break;
						
						case '1':
						case '4':
						case '5':
						case '6':
							mufo.admin=true;
							break;
						
						case '7': mufo.baxan=true;
							break;
						
						default: 
							mufo.udo=aar.udo.toString();	
							break;
					}				
					
					if (mufo.uloq=="naib")
					{
						mufo.duzelden=true; mufo.admin=true;
					}*/
					
					var mainApp:TTNDATVIMS = parentDocument as TTNDATVIMS;
					socet=mainApp.socet;
					
					socet.istif=mufo.userad+"~"+mufo.skype;
					socet.usid=mufo.usid;
					socet.osid=mufo.osid;
					 
					socet.qeyd =mufo.utel ;
					socet.suret=0;
					socet.say=1;
					socet.say1=1;
					socet.qeyd1=mufo.ptel ;
					socet.interval=30000;
					socet.start();
					persistenceManager.setProperty("mufo",mufo);
					persistenceManager.save();
					navigator.popView();
					navigator.firstView=views.Salam;			
					navigator.pushView(Salam,flipTrans);					
				}
					
				else
					
				{
					inff.text="İstifadəçi adı və ya parol YANLIŞDIR";
					if (StringUtil.trim(adstr.text).length>1)
						pstr.setFocus();
					else adstr.setFocus();
				}
				trace("login HHHH Hazir" +(new Date()).toString()+"--"+(new Date()).milliseconds);
				
					 
				trace("AXTAR HHHH Hazir" +(new Date()).toString()+"--"+(new Date()).milliseconds);
			}
		
		
			
	
			
			 
			
			
