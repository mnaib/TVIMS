				var xmlListCollection: XMLListCollection= new XMLListCollection(xml.Cedvel);
				
				
				
				
				sifararr= new ArrayCollection(xmlListCollection.toArray()); 
				
				//		sifarish.dataProvider=sifararr;
				
				//		axtarsifar.searchListCollection=sifararr;
				//		axtarsifar.dataGrid=sifarish;
				
				//					var stem:String='select F.*, fn.ad as "fnad", hal.ad as "halad",  F.LQN+'+"' '"+'+convert(varchar,F.Ldt,3) as "qeydiyyat"  from Lisenziya.dbo.firma F  left join Lisenziya.dbo.fn as fn on fn.id=F.fn  left join Lisenziya.dbo.hal as hal on hal.id=F.hal where F.id<30'; 
				var stem:String='select F.*, fn.ad as "fnad", hal.ad as "halad",  F.LQN+'+"' '"+'+convert(varchar,F.Ldt,3) as "qeydiyyat"  from Lisenziya.dbo.firma F  left join Lisenziya.dbo.fn as fn on fn.id=F.fn  left join Lisenziya.dbo.hal as hal on hal.id=F.hal '; 
