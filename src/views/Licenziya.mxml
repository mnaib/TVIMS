			private function firmar(event:Event):void
				
			{				
				var xml:XML=new XML(nlib.DataToXml(event.target));
				var xmlListCollection: XMLListCollection= new XMLListCollection(xml.Cedvel);
				firmaarr= new ArrayCollection(xmlListCollection.toArray()); 
				axtarfirma.searchListCollection=firmaarr;
				firma.dataProvider=firmaarr;
				
			}
			
			private function licaxtar(event:MouseEvent):void
			{
				
				var pro:String="' '";
				licarr.removeAll();
				obyarr.removeAll();
				///select I.*, T.ad as "Tad", T.kod as "Tkod" , T.fn  from Lisenziya.dbo.izin I  left join Lisenziya.dbo.tizin T on T.id=I.tizin  where firma=:firma
				
				//	select I.*, T.ad as "Tad", T.kod as "Tkod" , T.fn from Lisenziya.dbo.izin I left join Lisenziya.dbo.tizin T on T.id=I.tizin where firma=:firma',false);
				
				var steme:String='select T.ad as "Fad" from Lisenziya.dbo.izin I  left join Lisenziya.dbo.tizin T on T.id=I.tizin  where firma= '+
					firmaarr[firma.selectedIndex].id.toString()+'  and I.ok<>'+pro+ ' order by T.kod';
				//	licc.token=srv.execSQL(sqs,'DML',steme ,10000)
				nlib.GetUrl(steme  ,licr);
			}
			
			private function licr(event:Event):void {
				
				var xml:XML=new XML(nlib.DataToXml(event.target));
				var xmlListCollection: XMLListCollection= new XMLListCollection(xml.Cedvel);
				licarr= new ArrayCollection(xmlListCollection.toArray()); 
				
				lic.dataProvider=licarr;
				
				// 'select O.*, T.ad as "Tad", B.ad as "Bad"  from Lisenziya.dbo.obyekt O  left join umumi.dbo.teyinat T on T.id=O.teyinat  left join umumi.dbo.bolge B on B.id=O.bolge  where O.firma=:firma
				
				//
				var stemo:String='select O.*, T.ad as "tad", B.ad as "bad"  from Lisenziya.dbo.obyekt O  left join umumi.dbo.teyinat T on T.id=O.teyinat  left join umumi.dbo.bolge B on B.id=O.bolge  where O.firma='+firmaarr[firma.selectedIndex].id.toString();
				nlib.GetUrl(stemo  ,obyr);	
				//	obyc.token=srv.execSQL(sqs,'DML',stemo ,10000)
				
				
				
				
			}
			
			private function obyr(event:Event):void {
				var xml:XML=new XML(nlib.DataToXml(event.target));
				var xmlListCollection: XMLListCollection= new XMLListCollection(xml.Cedvel);
				obyarr= new ArrayCollection(xmlListCollection.toArray()); 
				oby.dataProvider=obyarr;
				
			}
			
			
			
			private function showTwoColumns2(rowItem:Object):String
			{
				return rowItem.rayon+"\  "+ rowItem.ad+"\  "+rowItem.id;
			}
			
			private function showTwoColumns(rowItem:Object):String
			{
				return rowItem.rayon;
			}
			
			
			
			private function nullLabelFunction(item:Object, column:GridColumn):String {
				if (item[column.dataField] == '<NULL>')
					return "";
				else
					return item[column.dataField];
			}
			
			import spark.events.IndexChangeEvent; 
			
			private function changeHandler(event:IndexChangeEvent):void { 
				
				if (event.newIndex==0)
				{
					lic.visible=true;
					oby.visible=false;
				}
				else
					
				{
					lic.visible=false;
					oby.visible=true;
				}
			} 
			
		]]>
	</fx:Script>
	
	
