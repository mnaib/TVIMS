			}


            // V3: keep ESRI Map and DataGrid as direct View children without transforms.
            private var mapLayoutPending:Boolean = false;
            private function requestMapLayout():void {
                if (mapLayoutPending) return;
                mapLayoutPending = true;
                callLater(applyMapLayout);
            }
            private function applyMapLayout():void {
                mapLayoutPending = false;
                var vw:Number = this.width;
                var vh:Number = this.height;
                if (isNaN(vw) || isNaN(vh) || vw < 200 || vh < 220) return;
                var pad:Number = 10;
                var gap:Number = 7;
                var rowH:Number = vh < 500 ? 38 : 45;
                var availW:Number = Math.max(180, vw - pad * 2);
                var controls:Array = [rejim, Avtomobil, Piyada, mesafe, Pauza,
                                     interval, vezsec, netsec];
                var regularWidths:Array = [108, 150, 150, 118, 64, 118, 194, 194];
                var cursorX:Number = 0;
                var cursorY:Number = 0;
                for (var i:int = 0; i < controls.length; ++i) {
                    var c:Object = controls[i];
                    var cw:Number = Math.min(regularWidths[i], availW);
                    if (cursorX > 0 && cursorX + cw > availW) {
                        cursorX = 0;
                        cursorY += rowH + gap;
                    }
                    c.x = cursorX;
                    c.y = cursorY;
                    c.width = cw;
                    c.height = rowH;
                    cursorX += cw + gap;
                }
                mapToolbar.x = pad;
                mapToolbar.y = pad;
                mapToolbar.width = availW;
                mapToolbar.height = cursorY + rowH;
                var mapY:Number = mapToolbar.y + mapToolbar.height + pad;
                var mapX:Number = pad;
                var mapW:Number;
                var mapH:Number;
                var infoX:Number;
                var infoY:Number;
                var infoW:Number;
                var infoH:Number;
                if (vw >= vh && vw >= 740) {
                    infoW = Math.min(325, Math.max(280, vw * 0.27));
                    mapW = Math.max(235, vw - infoW - pad * 3);
                    mapH = Math.max(140, vh - mapY - pad);
                    infoX = mapX + mapW + pad;
                    infoY = mapY;
                    infoH = mapH;
                } else {
                    mapW = availW;
                    var availH:Number = Math.max(140, vh - mapY - pad);
                    mapH = Math.max(125, Math.min(vh * 0.51, availH - 94));
                    mapH = Math.min(mapH, availH - 44);
                    infoX = pad;
                    infoY = mapY + mapH + pad;
                    infoW = availW;
                    infoH = Math.max(36, vh - infoY - pad);
                }
                maps.x = mapX;
                maps.y = mapY;
                maps.width = mapW;
                maps.height = mapH;
                // Grid covers exactly the map viewport when switched into list mode.
                obyced.x = mapX;
                obyced.y = mapY;
                obyced.width = mapW;
                obyced.height = mapH;
                mapInfoScroll.x = infoX;
                mapInfoScroll.y = infoY;
                mapInfoScroll.width = infoW;
                mapInfoScroll.height = infoH;
                mapInfoCanvas.width = infoW;
                mapInfoCanvas.height = 625;
                mapInfoFields.x = Math.max(0, Math.round((infoW - 280) / 2));
                // The map tools sit directly on View; no overlay intercepts taps or pans.
                myloc.x = mapX + 12;
                myloc.y = mapY + Math.min(100, Math.max(8, (mapH - 160) / 2));
                findloc.x = myloc.x;
                findloc.y = myloc.y + 49;
                handloc.x = myloc.x;
                handloc.y = myloc.y + 98;
                satbut.x = mapX + Math.max(1, mapW - 132);
                satbut.y = mapY + 10;
                gmapbut.x = satbut.x;
                gmapbut.y = mapY + 50;
                merlab.x = mapX + 12;
                merlab.y = mapY + Math.max(8, mapH - 85);
                parlab.x = merlab.x;
                parlab.y = merlab.y + 23;
                sevlab.x = merlab.x;
                sevlab.y = merlab.y + 46;
                maps.invalidateSize();
                maps.invalidateDisplayList();
            }

]]></fx:Script>
	
