			protected function view1_viewDeactivateHandler(event:ViewNavigatorEvent):void
				
			{

				minuteTimer.stop();
				 
				
				// designates listeners for the interval and completion events 
				minuteTimer.removeEventListener (TimerEvent.TIMER, getmesafe); 
				minuteTimer.removeEventListener(TimerEvent.TIMER_COMPLETE, onTimerComplete); 
				
				// starts the timer ticking 
				minuteTimer=null;
			}
			protected function view1_viewActivateHandler(event:ViewNavigatorEvent):void
				
			{ 
			 
			// 		return; 
				
				  if (Geolocation.isSupported) 
				{ 
					  geo = new Geolocation(); 
					
					
					geo.addEventListener(StatusEvent.STATUS, geoStatusHandler);
					addEventListener(ViewNavigatorEvent.REMOVING,onRemove);
					
					if (!geo.muted) 
						geo.addEventListener(GeolocationEvent.UPDATE, onUpdate); 
					else
						MobileAlert.show(' GPS-i işə salmaq lazımdır ' , 'Məlumat');
					
					
				} 
				else 
				{ 
					MobileAlert.show(' GPS qurğusu yoxdur ' , 'Məlumat')
				} 
				 
				
			}


			
