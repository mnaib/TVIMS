			private function result2(event:Event):void {
				
				 
					
					
					
					
					mufo.gor=false;
					
					
					trace("AXTAR GGG geldi" +(new Date()).toString()+"--"+(new Date()).milliseconds);
					
					var xml:XML=new XML(nlib.DataToXml(event.target));
					
					
					
					xml=xml.normalize();
					
					var cemddd:String="";
					for each (var s:XML in xml.Cedvel)
					{
						cemddd+=s.children()[0];
						
					}
					
					var	taar =JSON.parse( cemddd);
					
					var	aar =taar[0] ;
					
					
					
					
					if ( aar.id=="")
					{
						MobileAlert.show('Xəta 23: Yenidən daxil edin ' , 'Məlumat')
						return;  
					}
					if( (isNaN(Number( StringUtil.trim(aar.id))))  || ( StringUtil.trim(aar.id).length==0))
					{
						MobileAlert.show('Xəta 25: Yenidən daxil edin ' , 'Məlumat')
						return;  
					}
					
					mufo.Reset();
					mufo.osid=aar.id.toString(); 
					
					mufo.oad=aar.ad.toString();	
					mufo.duzelden=false;
					
					if (aar.rey)		mufo.orey=aar.rey.toString();
					
					
					//	ntey.text=tablexml.NewDataSet.Table.teyi.toString();
					if (aar.unvan)	mufo.ounv=aar.unvan.toString();
					if (aar.tey)		mufo.otey=aar.tey.toString();
					if (aar.teyid)		mufo.oteyid=aar.teyid.toString();
					if (aar.qeyd)		 mufo.oqeyd=aar.qeyd.toString();
					if (aar.ray)		mufo.oray=aar.ray.toString();
					if (aar.rayid)		mufo.orayid=aar.rayid.toString();
					if (aar.meridian)		mufo.meridian= aar.meridian.toString();
					if (aar.paralel)		mufo.paralel= aar.paralel.toString();
					
					if (aar.pod)		mufo.opod=aar.pod.toString();
					if (aar.it1)		mufo.it1=aar.it1.toString() ;
					if (aar.it2)		mufo.it2=aar.it2.toString() ;
					if (aar.it3)		mufo.it3=aar.it3.toString() ;
					if (aar.it4)	mufo.it4=aar.it4.toString() ;
					if (aar.it5)	mufo.it5=aar.it5.toString() ;
					if (aar.it6)	mufo.it6=aar.it6.toString() ;
					if (aar.sah)	mufo.osah=aar.sah.toString();
					if (aar.sahid)	mufo.osahid=aar.sahid.toString();
					if (aar.tip)	mufo.otip=aar.tip.toString();
					if (aar.tipid)	mufo.otipid=aar.tipid.toString();
					if (aar.sif)	mufo.osif=aar.sif.toString();
					if (aar.sifid)	mufo.osifid=aar.sifid.toString();
					if (aar.mmid)	mufo.ommid=aar.mmid.toString();
					if (aar.mm)	mufo.omm=aar.mm.toString();
					if (aar.vez)	mufo.ovez=aar.vez.toString();
					if (aar.qey)		mufo.oqey=aar.qey.toString();
					if (aar.qeyid)		mufo.oqeyid=aar.qeyid.toString();
					
					if (aar.sahilyani)		mufo.osahil=aar.sahilyani.toString();
					if (aar.iao)		mufo.oisgal=aar.iao.toString();
					
					
					
					if (aar.vezid)		mufo.ovezid=aar.vezid.toString();
					if (aar.basla)		mufo.obasla=aar.basla.toString().replace("T","");
					if (aar.son)			mufo.oson=aar.son.toString().replace("T","");;
					
					
					persistenceManager.setProperty("mufo",mufo);
					persistenceManager.save();
					 
				 
				
				navigator.popView(flipTrans);
				
			}
			
			
			
			
			public function geoStatusHandler(event:StatusEvent):void 
			{ 
				if (geo.muted){
					geo.removeEventListener(GeolocationEvent.UPDATE, onUpdate);
					MobileAlert.show(' GPS-i işə salmaq lazımdır ' , 'Məlumat');
				}
				else{
					MobileAlert.showt(' GPS-i işə salındı ' , 'Məlumat');
					geo.addEventListener(GeolocationEvent.UPDATE, geoStatusHandler);
				}	
			}
			protected function onUpdate(event:GeolocationEvent):void
				
			{
	 		if (!minuteTimer.running) return;
				
				gpsyeni=true;
				trace("Update event called");
				const  mapint:MapPoint     = new MapPoint(event.longitude, event.latitude,  new SpatialReference(4326))
				const parmer:MapPoint = WebMercatorUtil.geographicToWebMercator(mapint) as MapPoint;
				gpspoint.x=parmer.x;
				gpspoint.y=parmer.y;
				mappo=parmer;
				glat=event.latitude;
				glong=event.longitude;				
				merlab.text=event.longitude.toFixed(6);
				parlab.text=event.latitude.toFixed(6) ;
				sevlab.text=event.altitude.toFixed(1);
				/*		latitude.text= "Paralel:    " + event.latitude.toFixed(6) ; 
				longitude.text = "Meridian:   " + event.longitude.toFixed(6) ;
				altitude.text =  "Səviyyə:    " + event.altitude.toFixed(6) ;
				verticalAccuracy.text =  "H.dəq :     "+ event.verticalAccuracy.toFixed(2) ;
				horizontalAccuracy.text ="V.dəq:      " + event.horizontalAccuracy.toFixed(2);
				speed.text =     "Surət:      " + event.speed.toFixed(2) ;
				heading.text =   "İstiqamət:  "+ event.heading.toFixed(2) ;
				*/	
				gpsp.refresh();
				// auto-scroll the text area to the latest text
				//		StyleableTextField(log.textDisplay).scrollV = StyleableTextField(log.textDisplay).scrollV+1;
			}
			
			protected function onRemove(event:ViewNavigatorEvent):void
			{
				geo.removeEventListener(GeolocationEvent.UPDATE, onUpdate);				
			}
			
			
