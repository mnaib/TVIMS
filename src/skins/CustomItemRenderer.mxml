<?xml version="1.0" encoding="utf-8"?>
<!-- http://blog.flexexamples.com/2009/09/29/displaying-images-in-a-spark-list-control-using-a-custom-item-renderer-in-flex-4/ -->
<s:ItemRenderer name="CustomItemRenderer"
				xmlns:fx="http://ns.adobe.com/mxml/2009"
				xmlns:s="library://ns.adobe.com/flex/spark"
				focusEnabled="false"
				
				
				click="itemrenderer1_clickHandler(event);">
	
	<fx:Script>
		<![CDATA[
			import mx.events.ItemClickEvent;
			
			import spark.components.Image;
			
			[Bindable]
			public  var imgg:String;
			
			protected function itemrenderer1_clickHandler(evt:MouseEvent):void {
				var e:ItemClickEvent = new ItemClickEvent(ItemClickEvent.ITEM_CLICK, true);
				e.item = data;
				e.index = itemIndex;
				dispatchEvent(e);
			}
			override public function set data(value:Object):void 
				
			{ 				
				
				if (value) 		
				{ 
					super.data = value; 
					imgg=value.fulfid.toString();
					
					
				} 			
			} 
			
			
		]]>
	</fx:Script>
	
	
	
	<s:states>
		<s:State name="normal" />
		<s:State name="hovered" />
		<s:State name="selected" />
		<s:State name="normalAndShowsCaret" />
		<s:State name="hoveredAndShowsCaret" />
		<s:State name="selectedAndShowsCaret" />
	</s:states>
	
	
	
	<s:Rect id="rett" left="0" right="0" top="0" bottom="0">
		<s:fill>
			<s:SolidColor color="black"
						  alpha="0"
						  
						  alpha.hovered="0.4"
						  alpha.selected="0.4"
						  alpha.selectedAndShowsCaret="0.4" />
		</s:fill>
	</s:Rect>
	<s:Image  id="fert"  source="{imgg}" width="120"   height="150" scaleMode="stretch"      />
	
</s:ItemRenderer>