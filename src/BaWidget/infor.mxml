			private var zoomScale:Number = 1000;
			
			private function zoom_clickHandler(event:MouseEvent):void
			{ 
				var map:Map=FlexGlobals.topLevelApplication.map;
			 
				var here:MapPoint = map.toMap(new Point(map.infoWindow.anchorX, map.infoWindow.anchorY));
				if (map.scale > zoomScale)
				{
					map.level++;
					map.level++;
				}
				map.centerAt(here);
			}
			
			
			private var zoomSc:Number = 5000000;
			
			private function zoom_clickHand(event:MouseEvent):void
			{ 
				var map:Map=FlexGlobals.topLevelApplication.map;
				
				var here:MapPoint = map.toMap(new Point(map.infoWindow.anchorX, map.infoWindow.anchorY));
				if (map.scale < zoomSc)
				{
					map.level--;
					
				}
				map.centerAt(here);
			}
			
