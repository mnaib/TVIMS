			private function setInfoParameters(event:FlexEvent):void
			{
				if (data && fields)
				{
					try
					{
				
						//Clear all previous link info
						infoImage.source = "";
						infoImage.visible = false;
						infoImage.includeInLayout = false;
				
						mfotoc.nextButtonToolTip = multiImgNext;
						mfotoc.prevButtonToolTip = multiImgPrev;
                      
					   
						 
						 adstr=data["id"].toString();
				//		 lnum.text=adstr;
					
