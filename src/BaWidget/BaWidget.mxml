			protected function zoom_clickHandler(event:MouseEvent):void
			{
				var here:MapPoint = map.toMap(new Point(map.infoWindow.anchorX, map.infoWindow.anchorY));
				if (map.scale > zoomScale)
				{
					map.scale = zoomScale;
				}
				map.centerAt(here);
			}
			
			
			
		
			
		
			
			private function gresult(evt:ResultEvent):void {
				
			
				tablexml = XML(evt.result);
			lnum.text=osid;
				
				lad.text=tablexml.NewDataSet.Table.ad.toString();
				mfotoc.titulad=tablexml.NewDataSet.Table.ad.toString();
				lrey.text=tablexml.NewDataSet.Table.reyi.toString();
				ltey.text=tablexml.NewDataSet.Table.teyi.toString();
				lunv.text=tablexml.NewDataSet.Table.unvan.toString();
				lqeyd.text=tablexml.NewDataSet.Table.qeyd.toString();
				lboll.text=tablexml.NewDataSet.Table.boll.toString();
				ltar.text=tablexml.NewDataSet.Table.ytarix.toString();
 				mfotoc.iArray = tablexml.NewDataSet.Table.fotolar.toString().split(",");
			}
			private function gfault(evt:FaultEvent):void {
				Alert.show(evt.type);
				
